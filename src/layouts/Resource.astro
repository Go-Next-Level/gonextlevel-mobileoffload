---
import Enterprise from './Enterprise.astro';

interface FAQ { q: string; a: string }
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  answer: string;
  canonicalPath: string;
  breadcrumbs?: { label: string; href?: string }[];
  faqs?: FAQ[];
  dateModified?: string;
  articleType?: boolean;
  metaType?: string;
}

const {
  title,
  description,
  eyebrow,
  h1,
  answer,
  canonicalPath,
  breadcrumbs = [],
  faqs = [],
  dateModified = '2026-10-26',
  articleType = true,
  metaType = 'Commercial education',
} = Astro.props;

const canonicalURL = new URL(canonicalPath, Astro.site).href;
const crumbs = [{ label: 'Home', href: '/' }, ...breadcrumbs, { label: h1 }];
const graph: object[] = [
  {
    '@type': 'WebPage',
    '@id': `${canonicalURL}#webpage`,
    url: canonicalURL,
    name: title,
    description,
    isPartOf: { '@id': 'https://mobileoffload.com/#website' },
    about: { '@id': 'https://mobileoffload.com/#organization' },
    dateModified,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.label,
      item: crumb.href ? new URL(crumb.href, Astro.site).href : canonicalURL,
    })),
  },
];

if (articleType) {
  graph.push({
    '@type': 'Article',
    headline: h1,
    description,
    datePublished: '2026-10-26',
    dateModified,
    mainEntityOfPage: { '@id': `${canonicalURL}#webpage` },
    author: { '@id': 'https://mobileoffload.com/#organization' },
    publisher: { '@id': 'https://mobileoffload.com/#organization' },
  });
}

if (faqs.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  });
}

const schema = { '@context': 'https://schema.org', '@graph': graph };
const source = canonicalPath.replace(/^\//, '').replace(/\/$/, '');
const assessmentHref = `/network-assessment/?source=${encodeURIComponent(source)}`;
---
<Enterprise
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  schema={schema}
  ogType={articleType ? 'article' : 'website'}
  navLinks={[
    { href: '#guide', label: 'Guide' },
    { href: '#questions', label: 'Questions' },
    { href: '#sources', label: 'Sources' },
  ]}
  ctaLabel="Request an Assessment"
  ctaHref={assessmentHref}
>
  <section class="resource-hero">
    <div class="resource-grid" aria-hidden="true"></div>
    <div class="wrap resource-hero-inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((crumb, index) => (
            <li>
              {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}
              {index < crumbs.length - 1 && <span aria-hidden="true">/</span>}
            </li>
          ))}
        </ol>
      </nav>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="display">{h1}</h1>
      <div class="direct-answer" aria-label="Quick answer">
        <span class="direct-label">Direct answer</span>
        <p>{answer}</p>
      </div>
      <div class="resource-meta">
        <span>Reviewed October 26, 2026</span>
        <span>Published by MobileOffload</span>
        <span>{metaType}</span>
      </div>
    </div>
  </section>

  <article class="resource-article" id="guide">
    <div class="wrap resource-shell">
      <aside class="resource-rail" aria-label="On this page">
        <p>In this guide</p>
        <slot name="toc" />
        <a class="rail-cta" href={assessmentHref} data-assessment-cta="resource-rail">See if your locations qualify →</a>
      </aside>
      <div class="resource-content">
        <slot />
      </div>
    </div>
  </article>

  <style is:global>
    .resource-hero { position: relative; padding: 132px 0 72px; border-bottom: 1px solid var(--rule); overflow: hidden; }
    .resource-grid { position:absolute; inset:0; pointer-events:none; opacity:.32; background-image:linear-gradient(var(--rule) 1px,transparent 1px),linear-gradient(90deg,var(--rule) 1px,transparent 1px); background-size:72px 72px; mask-image:linear-gradient(to bottom,#000,transparent); }
    .resource-hero-inner { position: relative; max-width: 1060px; }
    .breadcrumbs ol { display:flex; flex-wrap:wrap; gap:8px; list-style:none; margin:0 0 34px; padding:0; }
    .breadcrumbs li { display:flex; gap:8px; color:var(--ink-3); font-size:13px; }
    .breadcrumbs a { color:var(--ink-2); }
    .resource-hero h1 { max-width: 18ch; margin:24px 0 28px; font-size:clamp(42px,6vw,72px); }
    .direct-answer { max-width:800px; padding:24px 26px; background:var(--white); border:1px solid var(--rule-dark); border-left:4px solid var(--blue); }
    .direct-answer p { color:var(--ink-2); font-size:18px; line-height:1.65; }
    .direct-label { display:block; margin-bottom:8px; color:var(--blue); font-family:var(--mono); font-size:10px; letter-spacing:.12em; text-transform:uppercase; }
    .resource-meta { display:flex; flex-wrap:wrap; gap:10px 24px; margin-top:22px; color:var(--ink-3); font-family:var(--mono); font-size:11px; letter-spacing:.04em; }
    .resource-article { padding:76px 0 96px; }
    .resource-shell { display:grid; grid-template-columns:240px minmax(0,760px); gap:80px; align-items:start; }
    .resource-rail { position:sticky; top:96px; border-top:2px solid var(--ink); padding-top:16px; }
    .resource-rail > p { margin-bottom:12px; font-family:var(--mono); font-size:11px; letter-spacing:.12em; text-transform:uppercase; }
    .resource-rail ul { list-style:none; padding:0; margin:0; }
    .resource-rail li { border-bottom:1px solid var(--rule); }
    .resource-rail a { display:block; padding:11px 2px; color:var(--ink-2); font-size:14px; text-decoration:none; }
    .resource-rail a:hover { color:var(--blue); }
    .resource-rail .rail-cta { margin-top:20px; padding:14px; color:var(--paper); background:var(--ink); font-weight:600; }
    .resource-content { min-width:0; }
    .resource-content h2 { margin:64px 0 20px; font:500 clamp(30px,4vw,42px)/1.12 var(--serif); letter-spacing:-.01em; scroll-margin-top:100px; }
    .resource-content h2:first-child { margin-top:0; }
    .resource-content h3 { margin:34px 0 12px; font:600 20px/1.3 var(--sans); scroll-margin-top:100px; }
    .resource-content p { margin:0 0 20px; color:var(--ink-2); font-size:17px; line-height:1.78; }
    .resource-content strong { color:var(--ink); }
    .resource-content ul, .resource-content ol { margin:0 0 26px; padding-left:24px; color:var(--ink-2); }
    .resource-content li { margin:9px 0; padding-left:5px; line-height:1.65; }
    .resource-content a { color:var(--blue-deep); text-underline-offset:3px; }
    .resource-content blockquote { margin:28px 0; padding:22px 26px; background:var(--blue-wash); border-left:3px solid var(--blue); }
    .resource-content blockquote p:last-child { margin-bottom:0; }
    .content-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; margin:28px 0; }
    .info-card { padding:24px; background:var(--white); border:1px solid var(--rule); }
    .info-card h3 { margin:0 0 10px; font-size:18px; }
    .info-card p { margin:0; font-size:15px; }
    .note { margin:30px 0; padding:20px 22px; background:var(--paper-2); border:1px solid var(--rule); font-size:15px; color:var(--ink-2); }
    .note strong { display:block; margin-bottom:4px; color:var(--ink); }
    .checklist { list-style:none !important; padding-left:0 !important; }
    .checklist li { position:relative; padding:12px 12px 12px 42px; border-bottom:1px solid var(--rule); }
    .checklist li::before { content:'✓'; position:absolute; left:10px; top:12px; color:var(--green); font-weight:700; }
    .table-scroll { margin:30px 0; overflow-x:auto; border:1px solid var(--rule-dark); background:var(--white); }
    .resource-table { width:100%; min-width:700px; border-collapse:collapse; font-size:14px; }
    .resource-table th { padding:14px 16px; background:var(--ink); color:var(--paper); text-align:left; font-family:var(--mono); font-size:10px; letter-spacing:.08em; text-transform:uppercase; }
    .resource-table td { padding:15px 16px; border-bottom:1px solid var(--rule); vertical-align:top; color:var(--ink-2); }
    .resource-table tr:last-child td { border-bottom:0; }
    .source-list { margin-top:64px; padding-top:28px; border-top:2px solid var(--ink); }
    .source-list h2 { margin-top:0; font-size:30px; }
    .source-list li { overflow-wrap:anywhere; }
    .resource-cta { margin:62px 0 0; padding:38px; background:var(--ink); color:var(--paper); }
    .resource-cta h2 { margin:0 0 12px; color:var(--paper); }
    .resource-cta p { color:rgba(251,250,247,.72); }
    .resource-cta a { display:inline-flex; min-height:48px; align-items:center; margin-top:8px; padding:12px 18px; color:var(--ink); background:var(--paper); text-decoration:none; font-weight:600; }
    .faq-list-resource { margin-top:28px; border-top:1px solid var(--rule-dark); }
    .faq-resource { border-bottom:1px solid var(--rule); }
    .faq-resource summary { min-height:60px; padding:18px 8px; cursor:pointer; color:var(--ink); font-weight:600; }
    .faq-resource p { padding:0 8px 20px; }
    .flow-diagram { display:grid; grid-template-columns:repeat(5,1fr); gap:8px; margin:32px 0; }
    .flow-step { position:relative; padding:18px 12px; background:var(--white); border:1px solid var(--rule-dark); text-align:center; font-size:13px; font-weight:600; }
    .flow-step:not(:last-child)::after { content:'→'; position:absolute; right:-9px; top:50%; z-index:2; transform:translateY(-50%); color:var(--blue); background:var(--paper); }
    @media (max-width:900px){ .resource-shell{grid-template-columns:1fr;gap:40px}.resource-rail{position:static}.resource-rail .rail-cta{max-width:340px}.flow-diagram{grid-template-columns:1fr}.flow-step:not(:last-child)::after{content:'↓';right:50%;top:auto;bottom:-16px;transform:translateX(50%)} }
    @media (max-width:640px){ .resource-hero{padding:112px 0 54px}.resource-article{padding:54px 0 76px}.content-grid{grid-template-columns:1fr}.resource-cta{padding:28px 22px}.direct-answer{padding:20px}.resource-content p{font-size:16px}.resource-meta{display:grid;gap:6px} }
  </style>
</Enterprise>
