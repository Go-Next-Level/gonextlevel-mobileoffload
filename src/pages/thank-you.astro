---
import Enterprise from '../layouts/Enterprise.astro';
---
<Enterprise
  title="Thank You — Mobile Offload"
  description="Thanks for your submission. We'll be in touch within 1 business day."
  noindex={true}
  navLinks={[]}
  ctaLabel="Back to Home"
  ctaHref="/"
>
  <script>oaiq("measure", "registration_completed", { type: "customer_action" });</script>

  <section class="hero" aria-label="Submission received" style="padding-bottom: 140px;">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="wrap hero-inner" style="max-width: 760px;">
      <p class="eyebrow">Submission Received</p>
      <h1 class="display" style="font-size: clamp(40px, 5.5vw, 68px); margin-top: 28px;">
        Thank you. <span class="hl">We're on it.</span>
      </h1>
      <p class="hero-sub">
        Our team will review your location details and be in touch within 1 business day with your
        free assessment. If anything is time-sensitive, text us at (530) 232-4445.
      </p>
      <div class="hero-ctas">
        <a href="/" class="btn-primary">Back to Home <span class="arr">→</span></a>
      </div>
    </div>
  </section>
</Enterprise>
