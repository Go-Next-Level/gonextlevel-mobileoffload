---
import Enterprise from '../layouts/Enterprise.astro';
import AssessSection from '../components/AssessSection.astro';

const title = "Redding Mobile Offload Program | Earn Monthly Income From Foot Traffic";
const description = "Redding business and property owners may qualify for monthly carrier program income through Mobile Offload. No hardware purchase, no equipment investment, and no disruption to your business.";

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mobileoffload.com/" },
    { "@type": "ListItem", "position": 2, "name": "Redding, CA", "item": "https://mobileoffload.com/redding" },
  ],
};

const navLinks = [
  { href: '#video', label: 'Overview' },
  { href: '#how-it-works', label: 'How It Works' },
  { href: '#network', label: 'Results' },
  { href: '#faq', label: 'FAQ' },
];

const locationTypes = [
  "Coffee Shops", "Restaurants", "Gyms & Fitness Centers", "Churches",
  "Hotels & Motels", "Medical Offices", "Retail Stores", "Shopping Centers",
  "Gas Stations", "Event Venues", "Campuses & Large Facilities", "Commercial Properties",
];

const steps = [
  { num: "01", title: "Your Existing Wi-Fi", desc: "No new hardware required in most cases. We use your current access points and infrastructure exactly as-is." },
  { num: "02", title: "Software Integration", desc: "A dedicated carrier SSID configured with Passpoint (Hotspot 2.0) and RadSec in about an hour — with zero impact on your existing networks." },
  { num: "03", title: "Automatic Carrier Offload", desc: "AT&T, T-Mobile, and Google Fi subscribers connect automatically when they enter your location. No passwords, no friction." },
  { num: "04", title: "Monthly Settlement", desc: "Carriers pay per gigabyte of data offloaded. You receive 50% by the 5th of each month, with a full transparency report." },
];

const noHardware = [
  { title: "No new hardware", desc: "We use your existing access points and infrastructure exactly as-is in most cases." },
  { title: "No equipment cost", desc: "Qualified locations do not need to purchase, lease, or finance any new equipment to participate." },
  { title: "No customer disruption", desc: "Carrier subscribers connect automatically in the background. Your customers and staff never notice a change." },
  { title: "~1 hour setup", desc: "Software configuration only, scheduled during off-peak hours so your business is never interrupted." },
];

const deployments = [
  { location: "Baltimore, MD",   type: "International Airport", scope: "Brownfield · 242 APs", monthly: "$9,625", annual: "$115,499", users: "5,945", data: "75 TB" },
  { location: "Glendale, CA",    type: "Shopping Mall",         scope: "Greenfield · 1 AP",    monthly: "$1,929", annual: "$23,464",  users: "1,419", data: "8.12 TB" },
  { location: "Irvine, CA",      type: "Fitness Center",        scope: "Greenfield · 1 AP",    monthly: "$1,824", annual: "$22,197",  users: "1,172", data: "7.79 TB" },
  { location: "New Orleans, LA", type: "Restaurant Group",      scope: "Brownfield · 3 APs",   monthly: "$889",   annual: "$10,662",  users: "5,023", data: "3.56 TB" },
  { location: "Studio City, CA", type: "Retail Location",       scope: "Greenfield · 1 AP",    monthly: "$577",   annual: "$7,023",   users: "1,082", data: "1.95 TB" },
];

const faqs = [
  { q: "Is this only for Redding businesses?", a: "No. Mobile Offload is a nationwide program already active across the country. This page is specifically for business and property owners in Redding, California who want a local point of contact to review whether their location may qualify." },
  { q: "Do I need to buy any equipment?", a: "No. Qualified locations do not need to purchase new hardware or equipment to participate in the program." },
  { q: "Will this disrupt my business or my customers?", a: "No. The program is designed from the ground up to avoid disrupting your customers, staff, or day-to-day operations. The carrier offload runs on a completely separate, isolated channel." },
  { q: "What types of Redding locations are a good fit?", a: "Locations with steady foot traffic are usually the best fit. Examples include coffee shops, restaurants, gyms, churches, hotels, retail stores, medical offices, gas stations, and shopping centers. If people regularly visit your property, it may be worth reviewing." },
  { q: "How much can my Redding location earn?", a: "Earnings depend on location type, foot traffic volume, carrier demand in your area, and qualification status. Live results from comparable deployments range from roughly $500 to $9,600+ per month — your assessment will model your specific location." },
  { q: "How does the revenue share work?", a: "Carrier revenue is split equally between Mobile Offload and the location partner — you receive 50% of all carrier payments generated by your location. There are no tiered structures, no sliding scales, and no fine print. Your share is paid by the 5th of each month with a full breakdown report." },
  { q: "Does this affect my existing internet or Wi-Fi?", a: "No. The carrier offload network runs on a completely separate SSID with dedicated bandwidth allocation. Your guest network, internal network, and POS systems are entirely untouched." },
  { q: "What carriers are supported?", a: "We currently support AT&T, T-Mobile, and Google Fi. Their subscribers connect automatically — no login screen or password required on their end." },
  { q: "How long does setup take?", a: "Approximately 1 hour. We work with your IT team or network administrator to configure a dedicated SSID and run connectivity tests. Setup is scheduled during off-peak hours to minimize any disruption." },
  { q: "What if I want to stop?", a: "Partner locations can cancel anytime during the first six months, no questions asked and no long-term contract. If you choose to continue after the first six months, the program automatically rolls into a one-year agreement that renews annually. This annual reliability requirement comes from the major carriers after a location has proven the program is working." },
];

const reddingVenueTypes = [
  "Restaurant / Bar",
  "Coffee Shop",
  "Fitness Center / Gym",
  "Church",
  "Hotel / Motel",
  "Medical Office",
  "Retail Store",
  "Shopping Center",
  "Gas Station",
  "Event Venue",
  "Campus / Large Facility",
  "Other",
];
---
<Enterprise
  title={title}
  description={description}
  schema={schema}
  navLinks={navLinks}
  ctaLabel="Check My Location"
  ctaHref="#assessment"
>

  <!-- ═══ HERO ═══════════════════════════════════════════════ -->
  <section class="hero" aria-label="Introduction">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="eyebrow">Redding, California · Local Program</p>
      <h1 class="display">Get paid when mobile data is used <span class="hl">at your Redding location.</span></h1>
      <p class="hero-sub">
        If your Redding location gets steady visitors, your property may be valuable to major mobile
        carriers looking to reduce network congestion. Mobile Offload helps qualified locations earn
        monthly income — no new hardware, no equipment purchases, and no changes to daily operations.
      </p>
      <div class="hero-ctas">
        <a href="#assessment" class="btn-primary">Check If My Location Qualifies <span class="arr">→</span></a>
        <a href="#video" class="btn-ghost">Watch the Overview</a>
      </div>
      <div class="hero-carriers" aria-label="Participating carriers">
        <span>Carriers on the network</span>
        <span class="carrier">AT&amp;T</span>
        <span class="carrier">T-Mobile</span>
        <span class="carrier">Google Fi</span>
      </div>
    </div>

    <!-- Metrics band -->
    <div class="metrics">
      <div class="wrap" style="padding: 0;">
        <div class="metrics-grid">
          <div class="metric">
            <div class="m-label">Estimated Monthly Range</div>
            <div class="m-value sm">$500–$9,600+</div>
            <div class="m-note">Based on live deployment data — varies by location type and foot traffic</div>
          </div>
          <div class="metric">
            <div class="m-label">Active Subscribers</div>
            <div class="m-value">124K+</div>
            <div class="m-note">Authenticated across six major carriers nationwide</div>
          </div>
          <div class="metric">
            <div class="m-label">Upfront Cost</div>
            <div class="m-value">$0</div>
            <div class="m-note">No hardware purchase, no equipment investment, no setup fee</div>
          </div>
          <div class="metric">
            <div class="m-label">Partner Revenue Share</div>
            <div class="m-value">50%</div>
            <div class="m-note">Of all carrier payments, settled by the 5th of each month</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ VIDEO ══════════════════════════════════════════════ -->
  <section class="section band-alt" id="video" aria-label="Program overview video">
    <div class="wrap" style="max-width: 980px;">
      <div style="margin-bottom: 44px;" class="reveal">
        <div class="sec-num" style="margin-bottom: 18px;">01 — Overview</div>
        <h2 class="display" style="font-size: clamp(32px, 4vw, 48px);">See how Mobile Offload works.</h2>
        <p style="margin-top: 18px; font-size: 17px; color: var(--ink-2); max-width: 60ch;">
          A short walkthrough for Redding business owners explaining how the program works and what
          types of locations may qualify.
        </p>
      </div>
      <div class="video-frame reveal">
        <iframe
          src="https://www.loom.com/embed/1f29ef5d49c54f9dabb70c34967bc3fe?hide_owner=true&hide_share=true&hide_title=true&hideEmbedTopBar=true"
          title="Mobile Offload Program Explainer for Redding Business Owners"
          allowfullscreen
          allow="autoplay; fullscreen"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ═══ THE OPPORTUNITY ════════════════════════════════════ -->
  <section class="section" aria-label="The opportunity for Redding businesses">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">02 — Opportunity</div>
        </div>
        <div>
          <p class="eyebrow">The Opportunity</p>
          <h2 class="display" style="margin-top: 22px;">Redding foot traffic may be more valuable than you think.</h2>
        </div>
      </div>
      <div class="two-col reveal">
        <div class="prose">
          <p>
            Every day, thousands of people move through Redding businesses, churches, hotels, gyms,
            restaurants, and retail locations using mobile data. Major carriers are actively looking
            for ways to reduce pressure on their networks in areas with consistent traffic — and they
            pay venue operators to carry that traffic over <strong>Wi-Fi offload</strong>.
          </p>
          <p>
            Mobile Offload connects qualified Redding properties with carrier-backed offload
            opportunities so participating locations can earn monthly income from the traffic they
            already have — <strong>no new hardware, no equipment purchases, and no disruption</strong>
            to daily operations.
          </p>
          <p>
            Revenue is paid monthly by the 5th, with a full breakdown report showing sessions,
            gigabytes offloaded, and carrier contributions. No guesswork, no chasing payments.
          </p>
        </div>
        <div>
          <blockquote class="pullquote">
            <p>"For mobile carriers, the challenge of grappling with ever-increasing traffic on their
            cellular networks will drive them to expand their Wi-Fi offloading capabilities."</p>
            <footer>— Wireless Broadband Alliance, 2026 Outlook</footer>
          </blockquote>
          <div class="growth-figure">
            <span class="gf-num">555%</span>
            <span class="gf-desc">growth in data offloaded across our network in five quarters</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ NO HARDWARE ════════════════════════════════════════ -->
  <section class="section band-white" aria-label="No hardware required">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">03 — Simplicity</div>
        </div>
        <div>
          <p class="eyebrow">How It's Different</p>
          <h2 class="display" style="margin-top: 22px;">No new hardware. No equipment purchase. No disruption.</h2>
          <p class="sh-sub">For qualified locations, the program works without buying new equipment, installing hardware, or changing how you serve customers.</p>
        </div>
      </div>
      <div class="terms-grid reveal">
        {noHardware.map((t) => (
          <div class="term">
            <h3>{t.title}</h3>
            <p>{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ HOW IT WORKS ═══════════════════════════════════════ -->
  <section class="section" id="how-it-works" aria-label="How it works">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">04 — Process</div>
        </div>
        <div>
          <p class="eyebrow">From Review to Revenue</p>
          <h2 class="display" style="margin-top: 22px;">Software-only. About an hour of setup.</h2>
          <p class="sh-sub">We handle everything technical, coordinated with your IT contact and scheduled off-peak — you just start getting paid.</p>
        </div>
      </div>
      <div class="steps-grid reveal">
        {steps.map((s) => (
          <div class="step">
            <div class="s-num">{s.num}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ WHO QUALIFIES ══════════════════════════════════════ -->
  <section class="section band-alt" id="qualifies" aria-label="Who may qualify">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">05 — Eligibility</div>
        </div>
        <div>
          <p class="eyebrow">Who May Qualify</p>
          <h2 class="display" style="margin-top: 22px;">Redding locations with regular daily visitors.</h2>
          <p class="sh-sub">The best fit is usually a location with steady foot traffic, longer dwell time, or repeat visitors. Not every property will qualify — the first step is a no-commitment review.</p>
        </div>
      </div>
      <div class="chips-grid reveal">
        {locationTypes.map((label, i) => (
          <div class="chip">
            <span class="c-idx">{String(i + 1).padStart(2, "0")}</span>
            <span class="c-label">{label}</span>
          </div>
        ))}
      </div>
      <div class="two-col reveal" style="margin-top: 56px;">
        <div class="prose">
          <p>
            <strong>Good fit indicators:</strong> regular daily foot traffic (50+ visitors per day),
            repeat visitors or longer dwell times, a commercial or public-facing property, existing
            network infrastructure on-site, and openness to a six-month trial window before the annual
            carrier agreement begins.
          </p>
        </div>
        <div class="prose">
          <p>
            Eligibility depends on location type, visitor volume, network demand, and carrier fit.
            There's no commitment involved in submitting — we'll review your Redding location and let
            you know if it looks like a potential match.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ NETWORK PERFORMANCE ════════════════════════════════ -->
  <section class="section" id="network" aria-label="Network performance">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">06 — Performance</div>
        </div>
        <div>
          <p class="eyebrow">Live Deployments</p>
          <h2 class="display" style="margin-top: 22px;">Audited results from the active network.</h2>
          <p class="sh-sub">Settlement figures from live carrier offload sites across the country. Greenfield denotes a new access point; brownfield runs entirely on existing infrastructure.</p>
        </div>
      </div>
      <div class="reveal">
        <div class="tbl-wrap">
          <table class="deployments">
            <thead>
              <tr>
                <th scope="col">Deployment</th>
                <th scope="col">Scope</th>
                <th scope="col">Avg Daily Users</th>
                <th scope="col">Data / Month</th>
                <th scope="col">Revenue / Month</th>
                <th scope="col">Annualized</th>
              </tr>
            </thead>
            <tbody>
              {deployments.map((d) => (
                <tr>
                  <td>
                    <div class="t-type">{d.type}</div>
                    <div class="t-loc">{d.location}</div>
                  </td>
                  <td><span class="t-scope">{d.scope}</span></td>
                  <td><span class="t-num">{d.users}</span></td>
                  <td><span class="t-num">{d.data}</span></td>
                  <td><span class="t-rev">{d.monthly}</span></td>
                  <td><span class="t-rev">{d.annual}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="tbl-footnote">
          Figures reflect the partner's 50% share of carrier settlement. Individual results vary with
          foot traffic, dwell time, and venue type.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ════════════════════════════════════════════════ -->
  <section class="section band-alt" id="faq" aria-label="Frequently asked questions">
    <div class="wrap" style="max-width: 900px;">
      <div style="margin-bottom: 52px;" class="reveal">
        <div class="sec-num" style="margin-bottom: 18px;">07 — Questions</div>
        <h2 class="display" style="font-size: clamp(32px, 4vw, 48px);">Common questions from Redding business owners.</h2>
      </div>
      <div class="faq-list reveal">
        {faqs.map((f, i) => (
          <div class="faq-item">
            <button type="button" class="faq-q" aria-expanded="false" aria-controls={`rfaq-${i}`} id={`rfaq-btn-${i}`}>
              {f.q}
              <span class="fq-mark" aria-hidden="true">+</span>
            </button>
            <div class="faq-a" id={`rfaq-${i}`} role="region" aria-labelledby={`rfaq-btn-${i}`}>
              <p>{f.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ ASSESSMENT FORM ════════════════════════════════════ -->
  <AssessSection
    secNum="08 — Engage"
    heading="See if your Redding location qualifies."
    sub="Submit your location and we'll review whether it may be a fit for the carrier offload program. Free review, no obligation, honest guidance."
    points={[
      { title: "Location review", desc: "We review your location type, visitor volume, and network setup." },
      { title: "Revenue assessment", desc: "A projection modeled from live deployment data for comparable locations." },
      { title: "Setup & settlement", desc: "About an hour of software configuration, then monthly payments by the 5th." },
    ]}
    formTitle="Redding Location Review"
    submitLabel="Check My Location →"
    venueTypes={reddingVenueTypes}
    sourceLabel="Mobile Offload — Qualification Form"
  />

</Enterprise>
