  <script define:vars={{ GHL_WEBHOOK }}>
    // ── Mobile menu ──
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    menuBtn?.addEventListener('click', () => {
      const open = mobileMenu.classList.toggle('open');
      menuBtn.setAttribute('aria-expanded', String(open));
    });
    mobileMenu?.querySelectorAll('a').forEach(a =>
      a.addEventListener('click', () => {
        mobileMenu.classList.remove('open');
        menuBtn.setAttribute('aria-expanded', 'false');
      })
    );

    // ── Scroll reveal ──
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.08 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));

    // ── FAQ accordion ──
    document.querySelectorAll('.faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item');
        const answer = btn.nextElementSibling;
        const wasOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item').forEach(el => {
          el.classList.remove('open');
          el.querySelector('.faq-a').style.maxHeight = '0';
          el.querySelector('.faq-q').setAttribute('aria-expanded', 'false');
        });
        if (!wasOpen) {
          item.classList.add('open');
          answer.style.maxHeight = answer.scrollHeight + 'px';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // ── Assessment form ──
    const form = document.getElementById('assess-form');
    const submitBtn = document.getElementById('v2-submit');
    const errorMsg = document.getElementById('v2-form-error');
    const consentRow = document.getElementById('v2-consent-row');
    const consentInput = document.getElementById('v2-consent');

    const emailOk = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

    function fieldWrap(el) { return el.closest('.f-field'); }

    form?.querySelectorAll('[required]').forEach(field => {
      if (field.type === 'checkbox') return;
      const clear = () => fieldWrap(field)?.classList.remove('invalid');
      field.addEventListener('input', clear);
      field.addEventListener('change', clear);
    });
    consentInput?.addEventListener('change', () => consentRow.classList.remove('invalid'));

    function validate() {
      let valid = true;
      let firstInvalid = null;
      form.querySelectorAll('[required]').forEach(field => {
        if (field.type === 'checkbox') {
          if (!field.checked) { consentRow.classList.add('invalid'); valid = false; firstInvalid ||= consentRow; }
          return;
        }
        const bad = !field.value.trim() || (field.type === 'email' && !emailOk(field.value));
        fieldWrap(field)?.classList.toggle('invalid', bad);
        if (bad) { valid = false; firstInvalid ||= field; }
      });
      if (firstInvalid) firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return valid;
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.style.display = 'none';
      if (!validate()) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting…';

      const val = (name) => form.elements.namedItem(name)?.value?.trim() ?? '';

      const payload = {
        firstName:       val('first_name'),
        lastName:        val('last_name'),
        email:           val('email'),
        phone:           val('phone'),
        name:            `${val('first_name')} ${val('last_name')}`.trim(),
        businessName:    val('business_name'),
        venueType:       val('venue_type'),
        businessAddress: val('business_address'),
        numLocations:    val('num_locations'),
        footTraffic:     val('foot_traffic'),
        wifiController:  val('wifi_controller'),
        heardFrom:       val('heard_from'),
        message:         val('message'),
        consentGiven:    'Yes',
        source:          'Mobile Offload — Qualification Form',
        tags:            ['mobile-offload-lead'],
      };

      try {
        const res = await fetch(GHL_WEBHOOK, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('Webhook error');
        window.location.href = '/thank-you';
      } catch {
        errorMsg.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Request Assessment →';
      }
    });
  </script>
