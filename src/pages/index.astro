---
import Enterprise from '../layouts/Enterprise.astro';
import AssessSection from '../components/AssessSection.astro';

const title = "MobileOffload | Commercial Wi-Fi Carrier Offload";
const description = "Understand carrier offload, assess commercial Wi-Fi compatibility, compare providers, and evaluate whether high-traffic business locations may qualify.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": "https://mobileoffload.com/#website", "url": "https://mobileoffload.com/", "name": "MobileOffload", "publisher": { "@id": "https://mobileoffload.com/#organization" } },
    { "@type": "Organization", "@id": "https://mobileoffload.com/#organization", "name": "MobileOffload", "legalName": "Goolsby Ventures LLC", "url": "https://mobileoffload.com/", "description": "Commercial carrier-offload education, network assessment, and deployment coordination for business Wi-Fi.", "contactPoint": { "@type": "ContactPoint", "contactType": "customer support", "telephone": "+1-530-232-4445", "email": "corey@mobileoffload.com" } },
    { "@type": "WebPage", "@id": "https://mobileoffload.com/#webpage", "url": "https://mobileoffload.com/", "name": title, "description": description, "isPartOf": { "@id": "https://mobileoffload.com/#website" } }
  ]
};

const deployments = [
  { location: "Source review pending", type: "International Airport", scope: "Upstream example", monthly: "Not verified", annual: "Not verified", users: "Not verified", data: "Not verified" },
  { location: "Source review pending", type: "Shopping Mall", scope: "Upstream example", monthly: "Not verified", annual: "Not verified", users: "Not verified", data: "Not verified" },
  { location: "Source review pending", type: "Fitness Center", scope: "Upstream example", monthly: "Not verified", annual: "Not verified", users: "Not verified", data: "Not verified" },
  { location: "Source review pending", type: "Restaurant Group", scope: "Upstream example", monthly: "Not verified", annual: "Not verified", users: "Not verified", data: "Not verified" },
  { location: "Source review pending", type: "Retail Location", scope: "Upstream example", monthly: "Not verified", annual: "Not verified", users: "Not verified", data: "Not verified" },
];

const segments = [
  { title: "Multi-Location Franchises", desc: "Franchise groups and operators with 10+ locations. One agreement, portfolio-wide deployment, consolidated monthly reporting across every site." },
  { title: "Airports & Transit Hubs", desc: "High-dwell, high-density environments where carrier networks are most congested — and where offload economics perform best." },
  { title: "Stadiums, Arenas & Venues", desc: "Event-driven traffic surges that cellular networks cannot absorb. Venue Wi-Fi becomes carrier capacity, monetized per gigabyte." },
  { title: "Shopping Centers & Malls", desc: "Anchor properties with thousands of daily visitors and existing enterprise Wi-Fi ready for Passpoint activation." },
  { title: "Hospitality Portfolios", desc: "Hotel groups and management companies. Guests offload automatically the moment they arrive — no captive portal, no login." },
  { title: "Campuses & Healthcare", desc: "Universities, hospital systems, and corporate campuses with large populations and enterprise-grade network infrastructure already in place." },
];

const steps = [
  { num: "01", title: "Network Assessment", desc: "We inventory locations, visitor patterns, access points, controller, firmware, backhaul, permissions, and current program availability." },
  { num: "02", title: "Technical Design", desc: "Where compatible, an isolated service profile is planned with the venue's IT or MSP. Hardware and timing depend on the actual environment." },
  { num: "03", title: "Pilot & Validation", desc: "Eligible device authentication, segmentation, capacity, monitoring, reporting, and rollback are tested before wider rollout." },
  { num: "04", title: "Reporting & Settlement", desc: "Eligible traffic and payments follow the current written program agreement. Participation and revenue are not guaranteed." },
];

const security = [
  { title: "Complete network separation", desc: "The carrier SSID is fully isolated from guest, internal, and POS networks. Zero overlap with business operations." },
  { title: "Client device isolation", desc: "Device-to-device communication is disabled on the offload SSID. Users cannot see or reach one another." },
  { title: "Zero access to your systems", desc: "Mobile Offload cannot access, modify, or monitor internal networks, customer data, or any other SSID." },
  { title: "Carrier-grade encryption", desc: "WPA3 Enterprise, Passpoint (Hotspot 2.0) authentication, and RadSec — RADIUS over TLS — end to end." },
];

const terms = [
  { title: "Six-month evaluation window", desc: "Cancel any time in the first six months. No questions, no penalty. The program stays month-to-month for the full window." },
  { title: "50 / 50 revenue share", desc: "Carrier revenue is split equally. No tiers, no sliding scales, no minimums. Paid by the 5th of each month." },
  { title: "Annual term after month six", desc: "Continuing partners roll into a one-year agreement — a reliability requirement set by the carriers, not by us." },
  { title: "Full data transparency", desc: "Monthly reports with sessions, gigabytes offloaded, and per-carrier breakdown — for every site in the portfolio." },
];

const faqs = [
  { q: "How does the revenue share work?", a: "Carrier revenue is split equally — your organization receives 50% of all carrier payments generated across your locations. No tiered structures and no fine print. Settlement is paid by the 5th of each month with full session-level reporting per site." },
  { q: "Does offload affect existing Wi-Fi performance?", a: "No. The carrier offload network runs on a completely separate SSID with dedicated bandwidth allocation. Guest networks, internal networks, and POS systems are untouched. We validate zero impact before any site goes live." },
  { q: "Which carriers participate?", a: "AT&T, T-Mobile, and Google Fi currently ride the network. All three authenticate subscribers through Passpoint (Hotspot 2.0) — automatic and invisible to the user, with no login screen." },
  { q: "Is new hardware required?", a: "In most deployments, no. If your access points support Passpoint / Hotspot 2.0 — standard on enterprise hardware from Cisco, Aruba, Ruckus, Juniper Mist, and others — we deploy on what you have. Where an addition is recommended, we handle it." },
  { q: "How is a multi-site rollout managed?", a: "One master agreement covers the portfolio. Sites are activated in coordinated waves with your IT team or MSP — roughly one hour of configuration per site, scheduled off-peak. Reporting is consolidated across all locations." },
  { q: "What if we want to exit?", a: "During the first six months, either party can exit with 30 days written notice — no termination fees, no penalties. On exit, every network is restored to its original configuration." },
];
---
<Enterprise title={title} description={description} schema={schema}>

  <!-- ═══ HERO ═══════════════════════════════════════════════ -->
  <section class="hero" aria-label="Introduction">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="eyebrow">Commercial Wi-Fi · Carrier offload assessment</p>
      <h1 class="display">Get paid when mobile data is used <span class="hl">across your locations.</span></h1>
      <p class="hero-sub">
        Some approved network programs compensate qualifying commercial operators for eligible mobile
        data carried over compatible Wi-Fi. MobileOffload helps portfolios assess technical readiness,
        current program fit, rollout scope, and written commercial terms.
      </p>
      <div class="hero-ctas">
        <a href="#assessment" class="btn-primary">Request a Network Assessment <span class="arr">→</span></a>
        <a href="#network" class="btn-ghost">View Network Performance</a>
      </div>
      <div class="hero-carriers" aria-label="Participating carriers">
        <span>Program participation varies by location</span>
        <span class="carrier">AT&amp;T</span>
        <span class="carrier">T-Mobile</span>
        <span class="carrier">Google Fi</span>
      </div>
    </div>

    <!-- Metrics band -->
    <div class="metrics">
      <div class="wrap" style="padding: 0;">
        <div class="metrics-grid">
          <div class="metric">
            <div class="m-label">Qualification</div>
            <div class="m-value">Site <sup>by site</sup></div>
            <div class="m-note">Traffic, network, permissions, and current program coverage reviewed individually</div>
          </div>
          <div class="metric">
            <div class="m-label">Compatibility</div>
            <div class="m-value">Model <sup>level</sup></div>
            <div class="m-note">Access point, controller, firmware, license, and configuration all matter</div>
          </div>
          <div class="metric">
            <div class="m-label">Measurement</div>
            <div class="m-value">Eligible <sup>only</sup></div>
            <div class="m-note">Total Wi-Fi traffic is not the same as billable program traffic</div>
          </div>
          <div class="metric">
            <div class="m-label">Commercials</div>
            <div class="m-value">In <sup>writing</sup></div>
            <div class="m-note">Rates, fees, venue share, timing, term, and exit conditions require review</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-white" aria-label="Carrier offload resources">
    <div class="wrap"><div class="section-head reveal"><div class="sh-left"><div class="sec-num">Start here</div></div><div><p class="eyebrow">Clear answers before the sales call</p><h2 class="display" style="margin-top:22px;">Understand the opportunity, limits, and provider models.</h2><p class="sh-sub">Carrier offload uses compatible Wi-Fi to carry eligible mobile traffic. It is not ordinary guest Wi-Fi, and owning a router does not create revenue by itself.</p></div></div>
      <div class="segments-grid reveal">
        <a class="segment" href="/carrier-offload/"><div class="seg-idx">01</div><h3>Carrier Offload Explained</h3><p>How automatic connections, network roles, measurement, and qualification work.</p></a>
        <a class="segment" href="/get-paid-for-wifi/"><div class="seg-idx">02</div><h3>Can Businesses Get Paid?</h3><p>A plain-language guide to who pays, why, and what ordinary Wi-Fi cannot do.</p></a>
        <a class="segment" href="/carrier-offload-companies/"><div class="seg-idx">03</div><h3>Compare Providers</h3><p>An objective buyer guide to ecosystems, integrators, managed services, and portfolio operators.</p></a>
        <a class="segment" href="/carrier-offload-earnings/"><div class="seg-idx">04</div><h3>Revenue Mechanics</h3><p>Eligible data, payment rates, venue shares, costs, and why projections vary.</p></a>
      </div>
    </div>
  </section>

  <!-- ═══ THE MANDATE ════════════════════════════════════════ -->
  <section class="section band-alt" aria-label="Why carriers pay for offload">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">01 — Market</div>
        </div>
        <div>
          <p class="eyebrow">The Carrier Mandate</p>
          <h2 class="display" style="margin-top: 22px;">Cellular networks are out of capacity. Yours is the relief valve.</h2>
        </div>
      </div>
      <div class="two-col reveal">
        <div class="prose">
          <p>
            Mobile data demand is compounding faster than carriers can build towers. In dense,
            high-dwell environments — airports, stadiums, malls, franchise networks — the macro
            network physically cannot keep up. The industry's answer is <strong>Wi-Fi offload</strong>:
            carriers pay venue operators to carry subscriber traffic over enterprise Wi-Fi.
          </p>
          <p>
            Through Passpoint (Hotspot 2.0), subscriber devices authenticate to a dedicated carrier
            SSID automatically — no login screens, no user action. To the carrier it is seamless
            network extension. To your organization it is <strong>a recurring infrastructure revenue
            line</strong> on assets you already own and operate.
          </p>
          <p>
            Mobile Offload operates the aggregation layer: one agreement, portfolio-wide deployment,
            consolidated settlement, and carrier-grade reporting across every site.
          </p>
        </div>
        <div>
          <blockquote class="pullquote">
            <p>"For mobile carriers, the challenge of grappling with ever-increasing traffic on their
            cellular networks will drive them to expand their Wi-Fi offloading capabilities."</p>
            <footer>— Wireless Broadband Alliance, 2026 Outlook</footer>
          </blockquote>
          <div class="growth-figure">
            <span class="gf-num">555%</span>
            <span class="gf-desc">growth in data offloaded across our network in five quarters</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ NETWORK PERFORMANCE ════════════════════════════════ -->
  <section class="section" id="network" aria-label="Network performance">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">02 — Performance</div>
        </div>
        <div>
          <p class="eyebrow">Live Deployments</p>
          <h2 class="display" style="margin-top: 22px;">Examples awaiting source verification.</h2>
          <p class="sh-sub">The prior site presented exact upstream deployment figures without supporting records in the repository. They are withheld pending owner verification, attribution, and publication permission.</p>
        </div>
      </div>
      <div class="reveal">
        <div class="tbl-wrap">
          <table class="deployments">
            <thead>
              <tr>
                <th scope="col">Deployment</th>
                <th scope="col">Scope</th>
                <th scope="col">Avg Daily Users</th>
                <th scope="col">Data / Month</th>
                <th scope="col">Revenue / Month</th>
                <th scope="col">Annualized</th>
              </tr>
            </thead>
            <tbody>
              {deployments.map((d) => (
                <tr>
                  <td>
                    <div class="t-type">{d.type}</div>
                    <div class="t-loc">{d.location}</div>
                  </td>
                  <td><span class="t-scope">{d.scope}</span></td>
                  <td><span class="t-num">{d.users}</span></td>
                  <td><span class="t-num">{d.data}</span></td>
                  <td><span class="t-rev">{d.monthly}</span></td>
                  <td><span class="t-rev">{d.annual}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="tbl-footnote">
          Do not use these examples to project earnings. See the <a href="/case-studies/">evidence policy and case-study methodology</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ HOW IT WORKS ═══════════════════════════════════════ -->
  <section class="section band-white" id="how-it-works" aria-label="Deployment process">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">03 — Deployment</div>
        </div>
        <div>
          <p class="eyebrow">From Assessment to Settlement</p>
          <h2 class="display" style="margin-top: 22px;">Software-only. About an hour per site.</h2>
          <p class="sh-sub">No hardware purchase in most deployments. No disruption to existing networks. Your IT team or MSP coordinates once — we handle the rest.</p>
        </div>
      </div>
      <div class="steps-grid reveal">
        {steps.map((s) => (
          <div class="step">
            <div class="s-num">{s.num}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ SEGMENTS ═══════════════════════════════════════════ -->
  <section class="section" id="segments" aria-label="Who we partner with">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">04 — Partners</div>
        </div>
        <div>
          <p class="eyebrow">Built for Scale</p>
          <h2 class="display" style="margin-top: 22px;">We partner with operators of high-traffic portfolios.</h2>
          <p class="sh-sub">Offload economics are driven by foot traffic, dwell time, and site count. These are the environments where the program performs.</p>
        </div>
      </div>
      <div class="segments-grid reveal">
        {segments.map((s, i) => (
          <div class="segment">
            <div class="seg-idx">{String(i + 1).padStart(2, "0")}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ SECURITY ═══════════════════════════════════════════ -->
  <section class="section security" id="security" aria-label="Security architecture">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">05 — Security</div>
        </div>
        <div>
          <p class="eyebrow">Isolation by Architecture</p>
          <h2 class="display" style="margin-top: 22px;">Your infrastructure is never touched.</h2>
          <p class="sh-sub">The offload network is architecturally isolated from business operations. This is the principle the entire security model is built on.</p>
        </div>
      </div>
      <div class="sec-grid reveal">
        <div class="sec-list">
          {security.map((s, i) => (
            <div class="sec-item">
              <div class="si-mark">{String(i + 1).padStart(2, "0")}</div>
              <div>
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="protocol-stack">
          <div class="ps-title">Authentication &amp; Encryption Stack</div>
          <div class="proto-row">
            <span class="p-name">WPA3 Enterprise</span>
            <span class="p-desc">Strongest Wi-Fi encryption standard</span>
          </div>
          <div class="proto-row">
            <span class="p-name">Passpoint / Hotspot 2.0</span>
            <span class="p-desc">Automatic secure carrier authentication</span>
          </div>
          <div class="proto-row">
            <span class="p-name">RadSec — RADIUS over TLS</span>
            <span class="p-desc">Encrypted authentication transport</span>
          </div>
          <div class="proto-row">
            <span class="p-name">Dedicated SSID</span>
            <span class="p-desc">Complete separation from your networks</span>
          </div>
          <p class="ps-note">
            <strong>Network architecture:</strong> the carrier SSID (AT&amp;T / T-Mobile / Fi) operates in
            full isolation from guest and internal networks. Mobile Offload has zero access to your systems,
            customer data, or POS environment — by design, not by policy.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TERMS ══════════════════════════════════════════════ -->
  <section class="section" id="terms" aria-label="Commercial terms">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">06 — Commercial</div>
        </div>
        <div>
          <p class="eyebrow">Straightforward Terms</p>
          <h2 class="display" style="margin-top: 22px;">Six months to evaluate. Carrier-grade commitment after.</h2>
          <p class="sh-sub">Cancel any time in the first six months, no questions asked. Continuing partners roll into an annual agreement — a reliability requirement set by the carriers.</p>
        </div>
      </div>
      <div class="terms-grid reveal">
        {terms.map((t) => (
          <div class="term">
            <h3>{t.title}</h3>
            <p>{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ════════════════════════════════════════════════ -->
  <section class="section band-alt" id="faq" aria-label="Frequently asked questions">
    <div class="wrap" style="max-width: 900px;">
      <div style="margin-bottom: 52px;" class="reveal">
        <div class="sec-num" style="margin-bottom: 18px;">07 — Questions</div>
        <h2 class="display" style="font-size: clamp(32px, 4vw, 48px);">Common questions.</h2>
      </div>
      <div class="faq-list reveal">
        {faqs.map((f, i) => (
          <div class="faq-item">
            <button type="button" class="faq-q" aria-expanded="false" aria-controls={`hfaq-${i}`} id={`hfaq-btn-${i}`}>
              {f.q}
              <span class="fq-mark" aria-hidden="true">+</span>
            </button>
            <div class="faq-a" id={`hfaq-${i}`} role="region" aria-labelledby={`hfaq-btn-${i}`}>
              <p>{f.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ ASSESSMENT FORM ════════════════════════════════════ -->
  <AssessSection />

</Enterprise>
