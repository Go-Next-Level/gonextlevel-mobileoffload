---
import Enterprise from '../layouts/Enterprise.astro';
import AssessSection from '../components/AssessSection.astro';
import EarningsReality from '../components/EarningsReality.astro';
import PortfolioBand from '../components/PortfolioBand.astro';

const title = "MobileOffload | Commercial Wi-Fi Carrier Offload";
const description = "Understand carrier offload, assess commercial Wi-Fi compatibility, compare providers, and evaluate whether high-traffic business locations may qualify.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": "https://mobileoffload.com/#website", "url": "https://mobileoffload.com/", "name": "MobileOffload", "publisher": { "@id": "https://mobileoffload.com/#organization" } },
    { "@type": "Organization", "@id": "https://mobileoffload.com/#organization", "name": "MobileOffload", "legalName": "Goolsby Ventures LLC", "url": "https://mobileoffload.com/", "description": "Commercial carrier-offload education, network assessment, and deployment coordination for business Wi-Fi.", "contactPoint": { "@type": "ContactPoint", "contactType": "customer support", "telephone": "+1-530-232-4445", "email": "corey@mobileoffload.com" } },
    { "@type": "WebPage", "@id": "https://mobileoffload.com/#webpage", "url": "https://mobileoffload.com/", "name": title, "description": description, "isPartOf": { "@id": "https://mobileoffload.com/#website" } }
  ]
};

const assessmentFactors = [
  { title: "Venue demand", desc: "Foot traffic, dwell time, indoor mobile usage, and the number of locations help determine whether an assessment is worthwhile." },
  { title: "Network readiness", desc: "Access-point models, controller software, firmware, licensing, backhaul capacity, and network design are reviewed for compatibility." },
  { title: "Program eligibility", desc: "Carrier participation, market coverage, site permissions, and eligible traffic requirements are confirmed for the proposed locations." },
  { title: "Commercial fit", desc: "Expected eligible traffic, implementation costs, reporting, revenue share, payment timing, and contract terms are evaluated together." },
];

const segments = [
  { title: "Multi-Location Franchises", desc: "Franchise groups and operators can evaluate a coordinated portfolio pilot, site qualification, and consolidated reporting requirements." },
  { title: "Airports & Transit Hubs", desc: "High-dwell, high-density environments may be candidates when the network, rights, coverage, and current program requirements align." },
  { title: "Stadiums, Arenas & Venues", desc: "Event-driven traffic makes capacity planning important, but eligibility and economics must be validated against real traffic and written terms." },
  { title: "Shopping Centers & Malls", desc: "Properties with substantial visitor dwell time and managed Wi-Fi can be assessed for Passpoint compatibility and program fit." },
  { title: "Hospitality Portfolios", desc: "Hotel groups can review access-point compatibility, guest-network separation, permissions, and eligible connection behavior by property." },
  { title: "Campuses & Healthcare", desc: "Large managed networks may be technically relevant, subject to security review, policy, authority, capacity, and current program availability." },
];

const steps = [
  { num: "01", title: "Network Assessment", desc: "We inventory locations, visitor patterns, access points, controller, firmware, backhaul, permissions, and current program availability." },
  { num: "02", title: "Technical Design", desc: "Where compatible, an isolated service profile is planned with the venue's IT or MSP. Hardware and timing depend on the actual environment." },
  { num: "03", title: "Pilot & Validation", desc: "Eligible device authentication, segmentation, capacity, monitoring, reporting, and rollback are tested before wider rollout." },
  { num: "04", title: "Reporting & Settlement", desc: "Eligible traffic and payments follow the current written program agreement. Participation and revenue are not guaranteed." },
];

const security = [
  { title: "Network separation", desc: "Document the proposed SSID, VLAN, routing, firewall policy, and separation from guest, internal, and payment environments." },
  { title: "Client isolation", desc: "Confirm device-to-device communication policy and test it during the pilot rather than assuming it from the platform name." },
  { title: "Administrative scope", desc: "Define exactly which parties receive controller, reporting, or support access and retain an auditable approval trail." },
  { title: "Authentication and encryption", desc: "Record the proposed Passpoint, EAP, RADIUS or RadSec, and Wi-Fi security configuration for technical review." },
];

const terms = [
  { title: "Payment basis", desc: "Identify the eligible traffic definition, measurement source, rate, venue share, deductions, thresholds, and reconciliation process." },
  { title: "Fees and equipment", desc: "List setup, license, support, backhaul, hardware, tax, and early-exit costs—including who pays when a site is incompatible." },
  { title: "Term and exit", desc: "Confirm pilot length, renewal, notice, termination assistance, configuration rollback, and any continuing obligations." },
  { title: "Reporting and audit", desc: "Specify reporting cadence, site-level fields, carrier or program detail, dispute windows, and access to underlying measurement records." },
];

const faqs = [
  { q: "How does carrier-offload compensation work?", a: "Some programs compensate a qualifying venue, network operator, or intermediary for defined eligible traffic. Rates, revenue shares, deductions, thresholds, payment timing, and reporting vary. Use the current written agreement—not a generic calculator—to evaluate a specific offer." },
  { q: "Does offload affect existing Wi-Fi performance?", a: "It can consume radio and backhaul capacity, so impact should be modeled and tested. A sound pilot defines segmentation, bandwidth policy, monitoring, rollback, and success thresholds before wider rollout." },
  { q: "Which carriers participate?", a: "Participation is program-, market-, venue-, and time-dependent. Ask for the current supported-network list, the authentication path, geographic scope, and the evidence used to identify eligible traffic in your proposal." },
  { q: "Is new hardware required?", a: "Sometimes. Compatibility depends on the exact access-point model, controller, firmware, licenses, radio capacity, network design, and the program's requirements. A model-level inventory is the right starting point." },
  { q: "How is a multi-site rollout managed?", a: "A practical rollout starts with inventory and rights review, then a limited pilot, measured acceptance criteria, and phased activation. Timing and contracting should be based on the actual portfolio rather than a universal per-site estimate." },
  { q: "Why doesn't MobileOffload publish an earnings calculator?", a: "Generic calculators rely on broad assumptions that no longer reflect how qualified carrier-offload opportunities are evaluated. Meaningful estimates require current carrier demand, compatible infrastructure, eligible usage, portfolio scale, pilot data, costs, and written commercial terms." },
  { q: "What should an exit plan cover?", a: "The agreement should state notice, fees, access revocation, configuration rollback, equipment ownership, data retention, final reporting, and dispute handling. Those terms should be reviewed before a pilot begins." },
];
---
<Enterprise title={title} description={description} schema={schema}>

  <!-- ═══ HERO ═══════════════════════════════════════════════ -->
  <section class="hero" aria-label="Introduction">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="eyebrow">Carrier Offload · AT&amp;T / T-Mobile / Google Fi</p>
      <h1 class="display">Get paid when mobile data is used <span class="hl">across your locations.</span></h1>
      <p class="hero-sub">
        Mobile carriers pay to route subscriber data through enterprise Wi-Fi in high-traffic venues.
        Mobile Offload activates that revenue across your entire portfolio — software-only deployment
        on your existing infrastructure, 50% of carrier payments settled monthly.
      </p>
      <div class="hero-ctas">
        <a href="#assessment" class="btn-primary">Request a Network Assessment <span class="arr">→</span></a>
        <a href="#network" class="btn-ghost">View Network Performance</a>
      </div>
      <div class="hero-carriers" aria-label="Participating carriers">
        <span>Carriers on the network</span>
        <span class="carrier">AT&amp;T</span>
        <span class="carrier">T-Mobile</span>
        <span class="carrier">Google Fi</span>
      </div>
    </div>

    <PortfolioBand />
  </section>

  <section class="section band-white" aria-label="Carrier offload resources">
    <div class="wrap"><div class="section-head reveal"><div class="sh-left"><div class="sec-num">Start here</div></div><div><p class="eyebrow">Clear answers before the sales call</p><h2 class="display" style="margin-top:22px;">Understand the opportunity, limits, and provider models.</h2><p class="sh-sub">Carrier offload uses compatible Wi-Fi to carry eligible mobile traffic. It is not ordinary guest Wi-Fi, and owning a router does not create revenue by itself.</p></div></div>
      <div class="segments-grid reveal">
        <a class="segment" href="/carrier-offload/"><div class="seg-idx">01</div><h3>Carrier Offload Explained</h3><p>How automatic connections, network roles, measurement, and qualification work.</p></a>
        <a class="segment" href="/get-paid-for-wifi/"><div class="seg-idx">02</div><h3>Can Businesses Get Paid?</h3><p>A plain-language guide to who pays, why, and what ordinary Wi-Fi cannot do.</p></a>
        <a class="segment" href="/carrier-offload-companies/"><div class="seg-idx">03</div><h3>Compare Providers</h3><p>An objective buyer guide to ecosystems, integrators, managed services, and portfolio operators.</p></a>
        <a class="segment" href="/carrier-offload-earnings/"><div class="seg-idx">04</div><h3>Revenue Mechanics</h3><p>Eligible data, payment rates, venue shares, costs, and why projections vary.</p></a>
      </div>
    </div>
  </section>

  <!-- ═══ THE MANDATE ════════════════════════════════════════ -->
  <section class="section band-alt" aria-label="Why carriers pay for offload">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">01 — Market</div>
        </div>
        <div>
          <p class="eyebrow">The Carrier Mandate</p>
          <h2 class="display" style="margin-top: 22px;">Wi-Fi can complement cellular capacity in the right environment.</h2>
        </div>
      </div>
      <div class="two-col reveal">
        <div class="prose">
          <p>
            Mobile traffic and indoor coverage needs make Wi-Fi an important part of converged
            connectivity. In some dense or high-dwell environments, <strong>Wi-Fi offload</strong>
            can carry eligible mobile traffic over a compatible, managed Wi-Fi network.
          </p>
          <p>
            Through Passpoint (Hotspot 2.0), subscriber devices authenticate to a dedicated carrier
            SSID automatically — no login screens, no user action. To the carrier it is seamless
            network extension. Some commercial programs may also compensate qualifying participants,
            but eligibility, payment structure, and results vary by program and site.
          </p>
          <p>
            MobileOffload helps commercial operators examine network readiness, program fit,
            rollout scope, and written commercial terms before committing.
          </p>
        </div>
        <div>
          <blockquote class="pullquote">
            <p>"For mobile carriers, the challenge of grappling with ever-increasing traffic on their
            cellular networks will drive them to expand their Wi-Fi offloading capabilities."</p>
            <footer>— Wireless Broadband Alliance, 2026 Outlook</footer>
          </blockquote>
          <div class="growth-figure">
            <span class="gf-num">4</span>
            <span class="gf-desc">essentials to assess: network, eligibility, operations, and commercial terms</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ ASSESSMENT FACTORS ═════════════════════════════════ -->
  <section class="section" id="network" aria-label="Network assessment factors">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">02 — Assessment</div>
        </div>
        <div>
          <p class="eyebrow">What We Evaluate</p>
          <h2 class="display" style="margin-top: 22px;">Is carrier offload a good fit for your locations?</h2>
          <p class="sh-sub">A network assessment brings the technical, operational, and commercial variables together so you can make a practical decision before committing to a rollout.</p>
        </div>
      </div>
      <div class="terms-grid reveal">
        {assessmentFactors.map((factor) => (
          <div class="term">
            <h3>{factor.title}</h3>
            <p>{factor.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <EarningsReality />

  <!-- ═══ HOW IT WORKS ═══════════════════════════════════════ -->
  <section class="section band-white" id="how-it-works" aria-label="Deployment process">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">04 — Deployment</div>
        </div>
        <div>
          <p class="eyebrow">From Assessment to Settlement</p>
          <h2 class="display" style="margin-top: 22px;">Assess first. Pilot second. Scale only after validation.</h2>
          <p class="sh-sub">Hardware, licensing, configuration effort, approvals, timing, and operational impact depend on the actual network and program.</p>
        </div>
      </div>
      <div class="steps-grid reveal">
        {steps.map((s) => (
          <div class="step">
            <div class="s-num">{s.num}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ SEGMENTS ═══════════════════════════════════════════ -->
  <section class="section" id="segments" aria-label="Who we partner with">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">05 — Partners</div>
        </div>
        <div>
          <p class="eyebrow">Built for Scale</p>
          <h2 class="display" style="margin-top: 22px;">We partner with operators of high-traffic portfolios.</h2>
          <p class="sh-sub">Foot traffic, dwell time, eligible-device presence, network capacity, permissions, and current program coverage all influence whether a site merits assessment.</p>
        </div>
      </div>
      <div class="segments-grid reveal">
        {segments.map((s, i) => (
          <div class="segment">
            <div class="seg-idx">{String(i + 1).padStart(2, "0")}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ SECURITY ═══════════════════════════════════════════ -->
  <section class="section security" id="security" aria-label="Security architecture">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">06 — Security</div>
        </div>
        <div>
          <p class="eyebrow">Isolation by Architecture</p>
          <h2 class="display" style="margin-top: 22px;">Require a documented, testable security design.</h2>
          <p class="sh-sub">Network separation, access scope, authentication, encryption, monitoring, and rollback should be reviewed for the proposed site—not inferred from a product label.</p>
        </div>
      </div>
      <div class="sec-grid reveal">
        <div class="sec-list">
          {security.map((s, i) => (
            <div class="sec-item">
              <div class="si-mark">{String(i + 1).padStart(2, "0")}</div>
              <div>
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="protocol-stack">
          <div class="ps-title">Authentication &amp; Encryption Stack</div>
          <div class="proto-row">
            <span class="p-name">Wi-Fi security mode</span>
            <span class="p-desc">Record supported and configured modes</span>
          </div>
          <div class="proto-row">
            <span class="p-name">Passpoint / Hotspot 2.0</span>
            <span class="p-desc">Validate profiles, credentials, and trust chain</span>
          </div>
          <div class="proto-row">
            <span class="p-name">AAA transport</span>
            <span class="p-desc">Document RADIUS or RadSec path and ownership</span>
          </div>
          <div class="proto-row">
            <span class="p-name">Segmentation</span>
            <span class="p-desc">Test VLAN, routing, firewall, and client policy</span>
          </div>
          <p class="ps-note">
            <strong>Acceptance requirement:</strong> the approved design should identify every administrative
            party, data flow, trust boundary, configuration change, monitoring control, and rollback step.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TERMS ══════════════════════════════════════════════ -->
  <section class="section" id="terms" aria-label="Commercial terms">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">07 — Commercial</div>
        </div>
        <div>
          <p class="eyebrow">Commercial diligence</p>
          <h2 class="display" style="margin-top: 22px;">Put every economic and exit term in writing.</h2>
          <p class="sh-sub">Published program terms can change. Evaluate the specific proposal, responsibilities, fees, payment mechanics, term, and exit path before authorizing a pilot.</p>
        </div>
      </div>
      <div class="terms-grid reveal">
        {terms.map((t) => (
          <div class="term">
            <h3>{t.title}</h3>
            <p>{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ════════════════════════════════════════════════ -->
  <section class="section band-alt" id="faq" aria-label="Frequently asked questions">
    <div class="wrap" style="max-width: 900px;">
      <div style="margin-bottom: 52px;" class="reveal">
        <div class="sec-num" style="margin-bottom: 18px;">08 — Questions</div>
        <h2 class="display" style="font-size: clamp(32px, 4vw, 48px);">Common questions.</h2>
      </div>
      <div class="faq-list reveal">
        {faqs.map((f, i) => (
          <div class="faq-item">
            <button type="button" class="faq-q" aria-expanded="false" aria-controls={`hfaq-${i}`} id={`hfaq-btn-${i}`}>
              {f.q}
              <span class="fq-mark" aria-hidden="true">+</span>
            </button>
            <div class="faq-a" id={`hfaq-${i}`} role="region" aria-labelledby={`hfaq-btn-${i}`}>
              <p>{f.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ ASSESSMENT FORM ════════════════════════════════════ -->
  <AssessSection secNum="09 — Engage" />

</Enterprise>
