---
import Enterprise from '../layouts/Enterprise.astro';

const title = "Mobile Offload for Gyms | Earn Monthly Income From Member Foot Traffic";
const description = "Gym and fitness center owners may qualify for monthly carrier program income through Mobile Offload. No hardware purchase, no equipment cost, and no disruption to your members or operations.";

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mobileoffload.com/" },
    { "@type": "ListItem", "position": 2, "name": "Gyms", "item": "https://mobileoffload.com/gyms" },
  ],
};

const navLinks = [
  { href: '#video', label: 'Overview' },
  { href: '#example', label: 'Real Results' },
  { href: '#how-it-works', label: 'How It Works' },
];

const GYM_WEBHOOK = 'https://services.leadconnectorhq.com/hooks/4aIMOOEHb5YojmrdglB9/webhook-trigger/7d700d2f-c93f-4696-b9a8-94dae4dc80c9';

const gymTypes = [
  "CrossFit Box",
  "Commercial / Traditional Gym",
  "Boutique Fitness Studio",
  "Yoga / Pilates Studio",
  "Martial Arts / MMA",
  "Functional Fitness",
  "Personal Training Studio",
  "Other",
];

const steps = [
  { num: "01", title: "We Assess Your Location", desc: "Submit your gym info and we review your location type, member volume, and existing network to confirm eligibility." },
  { num: "02", title: "Software-Only Setup", desc: "If your gym qualifies, we configure a dedicated carrier SSID on your existing equipment. No new hardware. Takes about an hour." },
  { num: "03", title: "Members Connect Automatically", desc: "AT&T, T-Mobile, and Google Fi subscribers automatically offload to your network when they're in your gym. No passwords, no friction." },
  { num: "04", title: "You Get Paid Monthly", desc: "Receive 50% of all carrier revenue generated by your gym, paid by the 5th of each month with a full data report." },
];
---
<Enterprise
  title={title}
  description={description}
  schema={schema}
  navLinks={navLinks}
  ctaLabel="See If My Gym Qualifies"
  ctaHref="#qualify"
>

  <!-- ═══ HERO ═══════════════════════════════════════════════ -->
  <section class="hero" aria-label="Introduction">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="eyebrow">For Gym &amp; Fitness Operators</p>
      <h1 class="display">Get paid when mobile data is used <span class="hl">at your gym.</span></h1>
      <p class="hero-sub">
        Your members stream music, podcasts, and video for 1–2 hours every visit. Major carriers pay
        to offload that data through your facility. Mobile Offload connects qualified gyms with those
        carrier payments — no new equipment, no disruption, no cost.
      </p>
      <div class="hero-ctas">
        <a href="#qualify" class="btn-primary">See If My Gym Qualifies <span class="arr">→</span></a>
        <a href="#video" class="btn-ghost">Watch the Overview</a>
      </div>
      <div class="hero-carriers" aria-label="Participating carriers">
        <span>Carriers on the network</span>
        <span class="carrier">AT&amp;T</span>
        <span class="carrier">T-Mobile</span>
        <span class="carrier">Google Fi</span>
      </div>
    </div>

    <!-- Metrics band -->
    <div class="metrics">
      <div class="wrap" style="padding: 0;">
        <div class="metrics-grid">
          <div class="metric">
            <div class="m-label">Example Gym, Annual</div>
            <div class="m-value">$22,197</div>
            <div class="m-note">Irvine, CA fitness center — live deployment, single access point</div>
          </div>
          <div class="metric">
            <div class="m-label">Equipment Cost</div>
            <div class="m-value">$0</div>
            <div class="m-note">Software-only deployment on your existing Wi-Fi in most cases</div>
          </div>
          <div class="metric">
            <div class="m-label">Revenue Share to You</div>
            <div class="m-value">50%</div>
            <div class="m-note">Of all carrier payments generated by your gym</div>
          </div>
          <div class="metric">
            <div class="m-label">Settlement</div>
            <div class="m-value sm">Monthly</div>
            <div class="m-note">Paid by the 5th of each month with a full data report</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ VIDEO ══════════════════════════════════════════════ -->
  <section class="section band-alt" id="video" aria-label="Program overview video">
    <div class="wrap" style="max-width: 980px;">
      <div style="margin-bottom: 44px;" class="reveal">
        <div class="sec-num" style="margin-bottom: 18px;">01 — Overview</div>
        <h2 class="display" style="font-size: clamp(32px, 4vw, 48px);">See how it works for gyms.</h2>
        <p style="margin-top: 18px; font-size: 17px; color: var(--ink-2); max-width: 60ch;">
          A short walkthrough for gym owners explaining how Mobile Offload works and what types of
          facilities may qualify.
        </p>
      </div>
      <div class="video-frame reveal">
        <iframe
          src="https://www.loom.com/embed/9abddd0b39b5412babe1b286896460e1?hide_owner=true&hide_share=true&hide_title=true&hideEmbedTopBar=true"
          title="Mobile Offload for Gym Owners — Video Explainer"
          allowfullscreen
          allow="autoplay; fullscreen"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ═══ REAL DEPLOYMENT EXAMPLE ════════════════════════════ -->
  <section class="section" id="example" aria-label="Real gym deployment">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">02 — Performance</div>
        </div>
        <div>
          <p class="eyebrow">Live Gym Deployment</p>
          <h2 class="display" style="margin-top: 22px;">Real results from a real fitness center.</h2>
          <p class="sh-sub">Gyms rank among the highest-earning venue types — members stay 1–2 hours and stream music or video the entire time. These are audited settlement figures from an active deployment.</p>
        </div>
      </div>
      <div class="reveal">
        <div class="tbl-wrap">
          <table class="deployments">
            <thead>
              <tr>
                <th scope="col">Deployment</th>
                <th scope="col">Scope</th>
                <th scope="col">Avg Daily Members</th>
                <th scope="col">Data / Month</th>
                <th scope="col">Revenue / Month</th>
                <th scope="col">Annualized</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <div class="t-type">Fitness Center</div>
                  <div class="t-loc">Irvine, CA</div>
                </td>
                <td><span class="t-scope">Greenfield · 1 AP</span></td>
                <td><span class="t-num">1,172</span></td>
                <td><span class="t-num">7.79 TB</span></td>
                <td><span class="t-rev">$1,824</span></td>
                <td><span class="t-rev">$22,197</span></td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="tbl-footnote">
          Figures reflect the partner's 50% share of carrier settlement from a single access point.
          Individual results vary with member volume, dwell time, and facility size.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ HOW IT WORKS ═══════════════════════════════════════ -->
  <section class="section band-white" id="how-it-works" aria-label="How it works">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <div class="sec-num">03 — Process</div>
        </div>
        <div>
          <p class="eyebrow">From Review to Revenue</p>
          <h2 class="display" style="margin-top: 22px;">Software-only. About an hour of setup.</h2>
          <p class="sh-sub">No hardware purchase in most deployments. No disruption to your members or your operations. We handle everything technical.</p>
        </div>
      </div>
      <div class="steps-grid reveal">
        {steps.map((s) => (
          <div class="step">
            <div class="s-num">{s.num}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ GYM QUALIFY FORM ═══════════════════════════════════ -->
  <section class="section assess" id="qualify" aria-label="See if your gym qualifies">
    <div class="wrap">
      <div class="assess-grid">
        <div class="assess-copy reveal">
          <div class="sec-num" style="margin-bottom: 18px;">04 — Engage</div>
          <h2 class="display">See if your gym qualifies.</h2>
          <p class="a-sub">
            Submit your gym's details and we'll review whether your facility may be a fit for the
            carrier offload program. Free review, no obligation.
          </p>
          <div class="assess-points">
            <div class="a-point">
              <span class="ap-num">01</span>
              <span class="ap-txt"><strong>Facility review</strong><span>We review your gym type, member volume, and network setup.</span></span>
            </div>
            <div class="a-point">
              <span class="ap-num">02</span>
              <span class="ap-txt"><strong>Revenue assessment</strong><span>A projection modeled from live gym deployment data.</span></span>
            </div>
            <div class="a-point">
              <span class="ap-num">03</span>
              <span class="ap-txt"><strong>Setup &amp; settlement</strong><span>About an hour of software configuration, then monthly payments by the 5th.</span></span>
            </div>
          </div>
          <p class="assess-contact">
            Direct: <a href="sms:+15302324445">(530) 232-4445</a> — text only<br/>
            <a href="mailto:corey@mobileoffload.com">corey@mobileoffload.com</a>
          </p>
        </div>

        <div class="form-card reveal">
          <div class="fc-title">Gym Qualification Request</div>
          <form id="gym-form" novalidate>
            <div class="f-grid">
              <div class="f-field">
                <label for="g-first">First Name <span class="req">*</span></label>
                <input type="text" id="g-first" name="first_name" required autocomplete="given-name" />
                <span class="f-err">Required</span>
              </div>
              <div class="f-field">
                <label for="g-last">Last Name <span class="req">*</span></label>
                <input type="text" id="g-last" name="last_name" required autocomplete="family-name" />
                <span class="f-err">Required</span>
              </div>
              <div class="f-field">
                <label for="g-email">Email <span class="req">*</span></label>
                <input type="email" id="g-email" name="email" required autocomplete="email" />
                <span class="f-err">Valid email required</span>
              </div>
              <div class="f-field">
                <label for="g-phone">Phone <span class="req">*</span></label>
                <input type="tel" id="g-phone" name="phone" required autocomplete="tel" />
                <span class="f-err">Required</span>
              </div>
              <div class="f-field">
                <label for="g-gym-name">Gym / Facility Name <span class="req">*</span></label>
                <input type="text" id="g-gym-name" name="gym_name" required autocomplete="organization" />
                <span class="f-err">Required</span>
              </div>
              <div class="f-field">
                <label for="g-gym-type">Gym Type <span class="req">*</span></label>
                <select id="g-gym-type" name="gym_type" required>
                  <option value="" disabled selected>Select…</option>
                  {gymTypes.map((t) => <option value={t}>{t}</option>)}
                </select>
                <span class="f-err">Please select</span>
              </div>
              <div class="f-field full">
                <label for="g-address">Gym Address <span class="req">*</span></label>
                <input type="text" id="g-address" name="gym_address" required autocomplete="street-address" placeholder="Street address, city, state" />
                <span class="f-err">Required</span>
              </div>
              <div class="f-field">
                <label for="g-locations">Number of Locations <span class="req">*</span></label>
                <select id="g-locations" name="num_locations" required>
                  <option value="" disabled selected>Select…</option>
                  <option value="1">1 location</option>
                  <option value="2-5">2–5 locations</option>
                  <option value="6-10">6–10 locations</option>
                  <option value="11-25">11–25 locations</option>
                  <option value="26+">26+ locations</option>
                </select>
                <span class="f-err">Please select</span>
              </div>
              <div class="f-field">
                <label for="g-daily">Daily Member Check-Ins <span class="req">*</span></label>
                <select id="g-daily" name="daily_members" required>
                  <option value="" disabled selected>Select…</option>
                  <option value="under-100">Under 100 / day</option>
                  <option value="100-300">100–300 / day</option>
                  <option value="300-600">300–600 / day</option>
                  <option value="600-1000">600–1,000 / day</option>
                  <option value="1000+">1,000+ / day</option>
                </select>
                <span class="f-err">Please select</span>
              </div>
              <div class="f-field">
                <label for="g-wifi">Wi-Fi Controller</label>
                <select id="g-wifi" name="wifi_controller">
                  <option value="">Not sure</option>
                  <option value="Aruba">Aruba</option>
                  <option value="Cambium cnMaestro">Cambium cnMaestro</option>
                  <option value="Fortinet">Fortinet</option>
                  <option value="Juniper Mist">Juniper Mist</option>
                  <option value="Meraki">Meraki</option>
                  <option value="Cisco Catalyst 9800">Cisco Catalyst 9800</option>
                  <option value="Cisco Catalyst 5520">Cisco Catalyst 5520</option>
                  <option value="MikroTik">MikroTik</option>
                  <option value="Ruckus">Ruckus</option>
                  <option value="Ubiquiti">Ubiquiti</option>
                  <option value="other">Other (please specify)</option>
                </select>
              </div>
              <div class="f-field">
                <label for="g-heard">How Did You Hear About Us?</label>
                <select id="g-heard" name="heard_from">
                  <option value="">Select…</option>
                  <option value="Google Search">Google Search</option>
                  <option value="Social Media">Social Media</option>
                  <option value="Referral from another gym owner">Referral from another gym owner</option>
                  <option value="Email">Email</option>
                  <option value="Podcast or Video">Podcast or Video</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div class="f-field full" id="g-wifi-other-wrap" style="display: none;">
                <label for="g-wifi-other">Please Specify Wi-Fi Equipment</label>
                <input type="text" id="g-wifi-other" name="wifi_controller_other" placeholder="Wi-Fi equipment make/model" />
              </div>
              <div class="f-field full">
                <label for="g-message">Anything Else We Should Know? (optional)</label>
                <textarea id="g-message" name="message" rows="3" placeholder="Any questions, context about your facility, or details that may help…"></textarea>
              </div>
              <div class="consent-row" id="g-consent-row">
                <label>
                  <input type="checkbox" id="g-consent" name="consent" required />
                  <span class="c-txt">
                    I agree that by submitting this form, <strong>Goolsby Ventures LLC (Mobile Offload)</strong> and its
                    partner <strong>Hudson House</strong> may contact me by phone, email, or text regarding carrier
                    offload network services. I have read and agree to the <a href="/privacy-policy" target="_blank">Privacy Policy</a>. <span class="req">*</span>
                  </span>
                </label>
                <span class="consent-err">You must agree to continue</span>
              </div>
              <div class="form-error-msg" id="g-form-error">Something went wrong. Please try again or contact us directly.</div>
              <button type="submit" class="f-submit" id="g-submit">See If My Gym Qualifies →</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

</Enterprise>

<script define:vars={{ GYM_WEBHOOK }}>
  const form = document.getElementById('gym-form');
  const submitBtn = document.getElementById('g-submit');
  const errorMsg = document.getElementById('g-form-error');
  const consentRow = document.getElementById('g-consent-row');
  const consentInput = document.getElementById('g-consent');

  const emailOk = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
  const fieldWrap = (el) => el.closest('.f-field');

  // Conditional "other" Wi-Fi field
  const wifiSelect = document.getElementById('g-wifi');
  const wifiOtherWrap = document.getElementById('g-wifi-other-wrap');
  wifiSelect?.addEventListener('change', () => {
    const other = wifiSelect.value === 'other';
    wifiOtherWrap.style.display = other ? 'block' : 'none';
    if (!other) document.getElementById('g-wifi-other').value = '';
  });

  form?.querySelectorAll('[required]').forEach(field => {
    if (field.type === 'checkbox') return;
    const clear = () => fieldWrap(field)?.classList.remove('invalid');
    field.addEventListener('input', clear);
    field.addEventListener('change', clear);
  });
  consentInput?.addEventListener('change', () => consentRow.classList.remove('invalid'));

  function validate() {
    let valid = true;
    let firstInvalid = null;
    form.querySelectorAll('[required]').forEach(field => {
      if (field.type === 'checkbox') {
        if (!field.checked) { consentRow.classList.add('invalid'); valid = false; firstInvalid ||= consentRow; }
        return;
      }
      const bad = !field.value.trim() || (field.type === 'email' && !emailOk(field.value));
      fieldWrap(field)?.classList.toggle('invalid', bad);
      if (bad) { valid = false; firstInvalid ||= field; }
    });
    if (firstInvalid) firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return valid;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.style.display = 'none';
    if (!validate()) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting…';

    const val = (name) => form.elements.namedItem(name)?.value?.trim() ?? '';

    const wifiController = val('wifi_controller') === 'other'
      ? `Other: ${val('wifi_controller_other')}`
      : val('wifi_controller');

    const payload = {
      firstName:      val('first_name'),
      lastName:       val('last_name'),
      email:          val('email'),
      phone:          val('phone'),
      name:           `${val('first_name')} ${val('last_name')}`.trim(),
      gymName:        val('gym_name'),
      gymType:        val('gym_type'),
      gymAddress:     val('gym_address'),
      numLocations:   val('num_locations'),
      dailyMembers:   val('daily_members'),
      wifiController: wifiController,
      heardFrom:      val('heard_from'),
      message:        val('message'),
      consentGiven:   'Yes',
      source:         'Mobile Offload — Gym Qualification Form',
      tags:           ['mobile-offload-gym-lead'],
    };

    try {
      const res = await fetch(GYM_WEBHOOK, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error('Webhook error');
      window.location.href = '/thank-you';
    } catch {
      errorMsg.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.textContent = 'See If My Gym Qualifies →';
    }
  });
</script>
