---
const qualificationSignals = [
  { label: 'Portfolio scale', value: 'Location mix + volume' },
  { label: 'Venue demand', value: 'Measured, not assumed' },
  { label: 'Eligible data', value: 'Validated in a pilot' },
  { label: 'Carrier participation', value: 'Current market fit' },
];
---

<section class="section band-white earnings-reality" id="earnings-calculator" aria-labelledby="earnings-title">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="sh-left">
        <div class="sec-num">03 — Earnings</div>
      </div>
      <div>
        <p class="eyebrow">The honest calculator</p>
        <h2 class="display" id="earnings-title">Why we don’t publish a one-size-fits-all earnings calculator.</h2>
        <p class="sh-sub">
          Earlier carrier-offload programs could support rough estimates for individual, smaller locations.
          Today, carriers increasingly prioritize venues and portfolios capable of producing meaningful,
          measurable data volume. A generic calculator would create false precision.
        </p>
      </div>
    </div>

    <div class="earnings-grid reveal">
      <div class="earnings-copy">
        <div class="market-shift" aria-label="How the carrier offload market has changed">
          <div class="shift-row">
            <span class="shift-era">Previous model</span>
            <p>Foot traffic and a broad per-gigabyte assumption could provide a rough small-site estimate.</p>
          </div>
          <div class="shift-row current">
            <span class="shift-era">Today</span>
            <p>Qualification depends on scale, compatible infrastructure, eligible usage, carrier demand, and current written terms.</p>
          </div>
        </div>

        <p class="earnings-summary">
          We model potential only after reviewing the real location portfolio, network, program availability,
          and commercial structure. The result is less flashy than an instant number—and far more useful.
        </p>

        <div class="earnings-actions">
          <a href="#assessment" class="btn-primary" data-assessment-cta="earnings-reality">
            Request a Real Earnings Assessment <span class="arr" aria-hidden="true">→</span>
          </a>
          <a href="/carrier-offload-earnings/" class="earnings-link">See how offload earnings work</a>
        </div>
      </div>

      <figure class="calculator-figure">
        <div class="calculator-shell">
          <div class="calculator-topbar">
            <div>
              <span class="calculator-kicker">Carrier offload</span>
              <h3>Earnings estimate</h3>
            </div>
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="4" y="2.5" width="16" height="19" rx="2"></rect>
              <path d="M7.5 6.5h9M8 11h1M11.5 11h1M15 11h1M8 14.5h1M11.5 14.5h1M15 14.5h1M8 18h1M11.5 18h1M15 18h1"></path>
            </svg>
          </div>

          <div class="calculator-fields">
            {qualificationSignals.map((signal) => (
              <div class="calculator-field">
                <span>{signal.label}</span>
                <strong>{signal.value}</strong>
              </div>
            ))}
          </div>

          <div class="formula" aria-label="Earnings depend on several connected factors">
            <span>Demand</span><b>×</b><span>Eligible data</span><b>×</b><span>Participation</span><b>×</b><span>Terms</span>
          </div>

          <div class="calculator-result">
            <span>Estimate status</span>
            <strong>Assessment required</strong>
            <p>Foot traffic alone cannot predict qualified offload revenue.</p>
          </div>

          <div class="calculator-foot">
            <span>No false precision</span>
            <span>Current inputs only</span>
            <span>Terms in writing</span>
          </div>
        </div>
        <figcaption>A credible estimate begins after technical and commercial qualification—not before.</figcaption>
      </figure>
    </div>

    <aside class="partner-economics reveal" aria-labelledby="partner-economics-title">
      <div class="share-mark" aria-label="50 percent partner share">
        <strong>50%</strong>
        <span>partner share</span>
      </div>
      <div>
        <p class="eyebrow">Partner-first economics</p>
        <h3 id="partner-economics-title">We don’t inflate the estimate. We maximize the qualified partner’s share.</h3>
        <p>Under our current standard structure, qualified partners receive 50% of applicable carrier payments, with reporting, deductions, and settlement terms stated in the written agreement.</p>
      </div>
    </aside>
  </div>
</section>

<style>
  .earnings-reality {
    position: relative;
    overflow: hidden;
  }
  .earnings-reality::before {
    content: '';
    position: absolute;
    width: 520px;
    height: 520px;
    top: 120px;
    right: -260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(11, 65, 194, 0.08), transparent 68%);
    pointer-events: none;
  }
  .earnings-reality .section-head h2 { margin-top: 22px; }
  .earnings-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(460px, 1.12fr);
    gap: 72px;
    align-items: center;
  }
  .market-shift { border-top: 1px solid var(--ink); }
  .shift-row {
    display: grid;
    grid-template-columns: 126px minmax(0, 1fr);
    gap: 22px;
    padding: 22px 0;
    border-bottom: 1px solid var(--rule);
  }
  .shift-row.current { background: linear-gradient(90deg, var(--blue-wash), transparent); }
  .shift-era {
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .shift-row.current .shift-era { color: var(--blue); }
  .shift-row p { color: var(--ink-2); font-size: 15px; line-height: 1.65; }
  .earnings-summary { margin-top: 28px; max-width: 58ch; color: var(--ink-2); font-size: 17px; line-height: 1.72; }
  .earnings-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 24px; margin-top: 32px; }
  .earnings-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--blue-deep);
    font-size: 14px;
    font-weight: 600;
    text-underline-offset: 4px;
  }
  .earnings-link:hover { color: var(--blue); }
  .earnings-link:focus-visible { outline: 3px solid rgba(11, 65, 194, 0.35); outline-offset: 4px; }

  .calculator-figure { position: relative; margin: 0; }
  .calculator-figure::before {
    content: '';
    position: absolute;
    inset: 18px -18px -18px 18px;
    border: 1px solid var(--rule-dark);
    background: var(--paper-2);
  }
  .calculator-shell {
    position: relative;
    z-index: 1;
    border: 1px solid var(--ink);
    background: var(--white);
    box-shadow: 0 28px 72px rgba(19, 26, 32, 0.13);
  }
  .calculator-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 24px;
    border-bottom: 1px solid var(--rule-dark);
    background: var(--paper-2);
    color: var(--ink);
  }
  .calculator-kicker { display: block; margin-bottom: 2px; color: var(--ink-3); font-family: var(--mono); font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; }
  .calculator-topbar h3 { font: 600 19px/1.2 var(--serif); }
  .calculator-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .calculator-field { min-height: 94px; padding: 19px 20px; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .calculator-field:nth-child(2n) { border-right: 0; }
  .calculator-field span { display: block; margin-bottom: 8px; color: var(--ink-3); font-family: var(--mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; }
  .calculator-field strong { display: block; color: var(--ink); font-size: 14px; line-height: 1.35; }
  .formula { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px; padding: 16px 20px; border-bottom: 1px solid var(--rule); background: var(--paper); }
  .formula span { color: var(--ink-2); font-family: var(--mono); font-size: 10px; text-transform: uppercase; }
  .formula b { color: var(--blue); font-family: var(--mono); font-size: 12px; }
  .calculator-result { padding: 26px 24px 28px; border-left: 5px solid var(--blue); background: var(--blue-wash); }
  .calculator-result span { display: block; color: var(--blue-deep); font-family: var(--mono); font-size: 9px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }
  .calculator-result strong { display: block; margin-top: 6px; color: var(--ink); font: 500 clamp(30px, 4vw, 42px)/1.05 var(--serif); letter-spacing: -0.02em; }
  .calculator-result p { margin-top: 10px; color: var(--ink-2); font-size: 14px; }
  .calculator-foot { display: flex; flex-wrap: wrap; gap: 8px; padding: 16px 20px; }
  .calculator-foot span { padding: 6px 9px; border: 1px solid var(--rule-dark); color: var(--ink-2); font-family: var(--mono); font-size: 9px; letter-spacing: 0.06em; text-transform: uppercase; }
  .calculator-figure figcaption { position: relative; z-index: 1; margin-top: 30px; color: var(--ink-3); font-size: 13px; line-height: 1.55; }

  .partner-economics {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 38px;
    align-items: center;
    margin-top: 86px;
    padding: 34px 40px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
  }
  .share-mark { display: flex; align-items: baseline; gap: 10px; padding-right: 32px; border-right: 1px solid rgba(251,250,247,0.25); }
  .share-mark strong { color: #fff; font: 500 54px/1 var(--serif); }
  .share-mark span { color: rgba(251,250,247,0.62); font-family: var(--mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; }
  .partner-economics .eyebrow { color: #9DB8F3; }
  .partner-economics .eyebrow::before { background: #9DB8F3; }
  .partner-economics h3 { margin-top: 12px; color: #fff; font: 500 clamp(25px, 3vw, 36px)/1.15 var(--serif); letter-spacing: -0.01em; }
  .partner-economics > div:last-child > p:last-child { margin-top: 12px; max-width: 72ch; color: rgba(251,250,247,0.72); font-size: 14px; line-height: 1.65; }

  @media (max-width: 980px) {
    .earnings-grid { grid-template-columns: 1fr; gap: 54px; }
    .calculator-figure { max-width: 680px; }
  }
  @media (max-width: 700px) {
    .shift-row { grid-template-columns: 1fr; gap: 8px; }
    .calculator-figure::before { inset: 10px -10px -10px 10px; }
    .calculator-fields { grid-template-columns: 1fr; }
    .calculator-field { min-height: auto; border-right: 0; }
    .partner-economics { grid-template-columns: 1fr; gap: 24px; margin-top: 64px; padding: 28px 22px; }
    .share-mark { padding: 0 0 20px; border-right: 0; border-bottom: 1px solid rgba(251,250,247,0.25); }
  }
  @media (max-width: 420px) {
    .calculator-topbar, .calculator-result { padding-left: 18px; padding-right: 18px; }
    .formula { justify-content: flex-start; }
    .earnings-actions .btn-primary { width: 100%; justify-content: center; text-align: center; }
  }
</style>
